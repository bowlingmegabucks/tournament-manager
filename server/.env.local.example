# Copy to .env and fill in values for local development.
# DB connects to the Docker MariaDB container via the mapped port.

PORT=3000

# Database — docker compose up db maps MariaDB to localhost:13306
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=tournament_manager
DB_USER=app
DB_PASSWORD=app

# CORS — dev client origin
CORS_ORIGINS=http://localhost:5173

# JWT
JWT_SECRET=change_me_before_use

# SSN encryption key (AES-256-GCM, 32-byte hex)
# openssl rand -hex 32
SSN_ENCRYPTION_KEY=
