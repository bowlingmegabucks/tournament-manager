# Copy to .env.docker and fill in values to override docker-compose.yml defaults.
# This file is safe to commit — .env.docker is gitignored.

# Database (defaults match docker-compose.yml service names/creds)
DB_HOST=db
DB_PORT=3306
DB_NAME=tournament_manager
DB_USER=app
DB_PASSWORD=app

# CORS — comma-separated allowed client origins
CORS_ORIGINS=https://tournament.bowlingmegabucks.com

# JWT
JWT_SECRET=change_me_before_use

# SSN encryption key (AES-256-GCM, 32-byte hex)
# openssl rand -hex 32
SSN_ENCRYPTION_KEY=
